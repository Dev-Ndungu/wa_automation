{
  "name": "whatsapp-group-control",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev --workspace=@wa-control/api\" \"npm run dev --workspace=@wa-control/web\"",
    "dev:api": "npm run dev --workspace=@wa-control/api",
    "dev:web": "npm run dev --workspace=@wa-control/web",
    "build": "npm run build --workspaces --if-present",
    "check": "npm run check --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:generate": "npm run db:generate --workspace=@wa-control/api",
    "db:migrate": "npm run db:migrate --workspace=@wa-control/api"
  },
  "devDependencies": {
    "@esbuild/win32-x64": "^0.28.2",
    "concurrently": "^9.2.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "sharp": "^0.35.3"
  }
}
