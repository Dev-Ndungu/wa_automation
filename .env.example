# Copy this file to .env. On a local first run, create the administrator in the dashboard.
NODE_ENV=development
PORT=3001
WEB_ORIGIN=http://localhost:5173
DATABASE_PATH=./data/wa-control.db
# For production only, set both values to seed the first administrator before startup.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
SESSION_TTL_HOURS=24
COOKIE_SECURE=false
LOG_LEVEL=info

# Reserved for later WhatsApp and deployment phases. Never commit real values.
WHATSAPP_AUTH_DIR=./whatsapp-auth
CADDY_EMAIL=
